# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Security: Server-Side ONLY (Never prefix with NEXT_PUBLIC_ or expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Farm Location for Open-Meteo Weather (Defaults to Oakridge Farm, CA)
NEXT_PUBLIC_FARM_LAT=38.544907
NEXT_PUBLIC_FARM_LON=-121.740517
NEXT_PUBLIC_FARM_NAME="Oakridge Organic Farm"

